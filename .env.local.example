# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# API interne (pour POST /api/articles, /api/newsletter/send, /api/newsletter/weekly)
INTERNAL_API_TOKEN=

# Code de bootstrap admin — utilisé une seule fois sur /admin-setup
ADMIN_SETUP_CODE=

# Email — SMTP Hostinger
# Si SMTP_HOST vide → lib/email/smtp.ts log dans la console (mode dev)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@egp.hedjav.com
SMTP_PASS=
SMTP_FROM=noreply@egp.hedjav.com

# ─── COUCHE IA UNIFIEE ──────────────────────────────────────────────
# lib/ai/client.ts parle a DeepSeek, OpenAI ou Anthropic via la meme API.
# Si aucune cle n'est renseignee, l'app fonctionne sans IA
# (degradation contrôlee : "skipped").
# JAMAIS DE CLE EN DUR DANS LE CODE. TOUJOURS VIA CES VARIABLES.

# Choix du provider : "deepseek" | "openai" | "anthropic" | "auto"
# "auto" = DeepSeek > OpenAI > Anthropic, selon les cles disponibles.
AI_PROVIDER=auto

# DeepSeek — https://platform.deepseek.com/api_keys
# Provider par defaut en "auto" (rapport qualite/prix eleve).
# API OpenAI-compatible, pas besoin d'un SDK dedie.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # optionnel, pour proxy ou preview

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# FedaPay (paiement)
FEDAPAY_API_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://egp.hedjav.com
